# Configuration for the end-to-end test API. Bun loads this on top of .env when
# NODE_ENV=test, then .env.test.local last (.env.local is skipped under test).
#
# Everything here is for the throwaway helpdesk_test database only and is
# committed on purpose. Do not put real secrets in this file: set the real
# DATABASE_URL (with your Postgres password) in .env.test.local, which is
# gitignored. The database name must end in "_test" or the reset script
# refuses to run.
PORT=3001
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk_test?schema=public"

BETTER_AUTH_SECRET="e2e-only-not-a-secret-0123456789abcdefghijklmnop"
BETTER_AUTH_URL="http://localhost:3001"
# The Vite dev server the tests drive. Its proxy forwards the browser's Origin
# header, which Better Auth checks against this list.
TRUSTED_ORIGINS="http://localhost:5174"

# The admin the reset script seeds. Tests sign in with these.
SEED_ADMIN_EMAIL="admin@test.local"
SEED_ADMIN_NAME="Test Admin"
SEED_ADMIN_PASSWORD="test-admin-password"

# Inbound email for the e2e stack. Throwaway, like BETTER_AUTH_SECRET above:
# the specs sign their own payloads with this value, so it has to be the same
# string on both sides, and it is committed for that reason alone.
INBOUND_EMAIL_PROVIDER="mailgun"
INBOUND_EMAIL_SECRET="e2e-only-inbound-secret-0123456789abcdefghij"
SUPPORT_EMAIL_ADDRESS="support@test.local"

# No AI in the e2e stack, deliberately, and this is why it is set rather than
# simply absent: Bun loads server/.env first and layers .env.test on top, so a
# developer's real OPENAI_API_KEY would otherwise still be in the environment -
# and every inbound-email spec would make a live classification call. Empty
# means `env.openai.apiKey` is undefined, so the classifier logs a 503 and leaves
# `category` null, which is what the ticket specs expect, and the Polish and
# Summarise buttons answer 503 instead of spending money on a test run.
OPENAI_API_KEY=
