# Copy to .env and adjust. Never commit .env.
PORT=3000
NODE_ENV=development

# PostgreSQL connection. Replace YOUR_PASSWORD with the password set when
# PostgreSQL was installed.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"

# Better Auth. The secret signs session cookies - rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_STRING"
BETTER_AUTH_URL="http://localhost:3000"

# The initial admin account, created by `bun run db:seed`. There is no
# self-registration: every other account is made by an admin in the UI.
# Re-running the seed leaves an existing admin alone rather than resetting it;
# `bun run db:seed -- --repair` is the opt-in that does reset the password.
# SEED_ADMIN_NAME is optional and defaults to "Admin".
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
