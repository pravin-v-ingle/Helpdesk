# Copy to .env and adjust. Never commit .env.
PORT=3000
NODE_ENV=development

# PostgreSQL connection. Replace YOUR_PASSWORD with the password set when
# PostgreSQL was installed.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"

# Better Auth. The secret signs session cookies - rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_STRING"
# The public origin the API is reached at. In production this is required and
# must be https:// - the session cookie's Secure flag is derived from it.
BETTER_AUTH_URL="http://localhost:3000"

# Origins Better Auth accepts requests from, comma-separated, on top of
# BETTER_AUTH_URL which is always trusted. Outside production this defaults to
# the Vite dev server, so it can be left unset locally. In production set it to
# the domain that serves the client - there is no default there, because
# shipping a build that trusts localhost would be a quiet mistake, and the
# server refuses to start without it.
# TRUSTED_ORIGINS="https://helpdesk.example.com"

# Reverse proxies in front of the API, comma-separated, as IPs, CIDR ranges or
# Express's keywords (loopback, linklocal, uniquelocal). X-Forwarded-For is
# only believed from these, and the resulting client IP is what the sign-in
# rate limiter keys on. Leave unset when the API is reached directly.
# TRUSTED_PROXIES="loopback"

# The initial admin account, created by `bun run db:seed`. There is no
# self-registration: every other account is made by an admin in the UI.
# Re-running the seed leaves an existing admin alone rather than resetting it;
# `bun run db:seed -- --repair` is the opt-in that does reset the password.
# SEED_ADMIN_NAME is optional and defaults to "Admin".
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
