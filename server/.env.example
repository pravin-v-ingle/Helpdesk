# Copy to .env and adjust. Never commit .env.
PORT=3000
NODE_ENV=development

# PostgreSQL connection. Replace YOUR_PASSWORD with the password set when
# PostgreSQL was installed.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"

# Better Auth. The secret signs session cookies - rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_STRING"
# The public origin the API is reached at. In production this is required and
# must be https:// - the session cookie's Secure flag is derived from it.
BETTER_AUTH_URL="http://localhost:3000"

# Origins Better Auth accepts requests from, comma-separated, on top of
# BETTER_AUTH_URL which is always trusted. Outside production this defaults to
# the Vite dev server, so it can be left unset locally. In production set it to
# the domain that serves the client - there is no default there, because
# shipping a build that trusts localhost would be a quiet mistake, and the
# server refuses to start without it.
# TRUSTED_ORIGINS="https://helpdesk.example.com"

# Reverse proxies in front of the API, comma-separated, as IPs, CIDR ranges or
# Express's keywords (loopback, linklocal, uniquelocal). X-Forwarded-For is
# only believed from these, and the resulting client IP is what the sign-in
# rate limiter keys on. Leave unset when the API is reached directly.
# TRUSTED_PROXIES="loopback"

# The initial admin account, created by `bun run db:seed`. There is no
# self-registration: every other account is made by an admin in the UI.
# Re-running the seed leaves an existing admin alone rather than resetting it;
# `bun run db:seed -- --repair` is the opt-in that does reset the password.
# SEED_ADMIN_NAME is optional and defaults to "Admin".
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Inbound email. Which provider posts to POST /api/email/inbound, and therefore
# which adapter verifies the payload: "mailgun" (the default) or "sendgrid".
# Getting this wrong rejects every inbound email with a 401, because the other
# provider's signature scheme does not verify.
INBOUND_EMAIL_PROVIDER="mailgun"

# The shared secret that webhook authenticates with. Its meaning is the chosen
# provider's: for Mailgun it is the HTTP webhook signing key from the control
# panel; for SendGrid, whose Inbound Parse has no signature mechanism at all,
# it is the password embedded in the parse URL and sent as HTTP Basic
# credentials. Either way it is the only thing between the internet and ticket
# creation. Outside production it falls back to a fixed development value, so
# `bun run email:test` works with no setup; in production it is required and
# must be at least 32 characters.
# INBOUND_EMAIL_SECRET="REPLACE_WITH_THE_PROVIDER_SIGNING_KEY"

# The support mailbox mail arrives at. Optional. Used to pick our own recipient
# out of mail addressed to several, so the requester's address is never set
# from ours, and to recognise our own outbound mail coming back - which is what
# stops a mail loop once outbound send exists. It is also the From address on a
# reply the knowledge-base auto-resolver writes, so with this unset those replies
# are attributed to a visible placeholder, `support@localhost`.
# SUPPORT_EMAIL_ADDRESS="support@helpdesk.example.com"

# Where the support knowledge base is, if not `knowledge-base.md` at the
# repository root. Optional, and unset is the normal case - the default is
# resolved from the server's own module path rather than the working directory,
# so it is found whether the process was started from the root or from server/.
#
# That file is server INPUT, not documentation: the auto-resolver answers new
# tickets from it and resolves them, so editing it changes what the system will
# tell a student, and section 10's escalation rules are mirrored by
# ESCALATION_PHRASES in services/auto-resolve-ticket.ts. It is read once and
# cached for the life of the process, so an edit needs a restart.
#
# A missing, unreadable or very short (<200 character) file switches the
# auto-resolver off entirely and every ticket stays OPEN for a human - which is
# deliberate, since a model asked to answer policy questions from nothing is a
# model inventing policy. There is no feature flag; this and OPENAI_API_KEY are
# the gate.
# KNOWLEDGE_BASE_PATH="/etc/helpdesk/knowledge-base.md"

# OpenAI, for the four AI features: the two buttons on the ticket detail page -
# Polish, which rewrites an agent's draft reply, and Summarise, which summarises
# the ticket and its conversation, neither storing anything - plus the two jobs
# that run when a ticket arrives, with nobody asking: classification, which sets
# the category, and auto-resolution, which answers the ticket from
# KNOWLEDGE_BASE_PATH above and marks it RESOLVED when the knowledge base covers
# it. Optional, and the only optional secret here: with no key the server still
# boots and serves everything else, the two endpoints answer 503 with a sentence
# the page shows, and the two jobs log and do nothing - so a ticket simply arrives
# uncategorised and unanswered. Every other AI feature in this system is
# Anthropic's; see tech-stack.md.
#
# Note that with a key set, every inbound email costs two model calls, each
# retried up to three times, with no budget and no sampling.
# OPENAI_API_KEY="sk-..."
# The model all four features ask. Defaults to gpt-5-nano - the cheapest and
# fastest of the family, which is the right trade for small text jobs an agent
# reads and can discard. One setting for all of them, because they are the same
# kind of work on the same size of input. Overridable because a model id is the one
# setting here that goes stale on somebody else's schedule.
# OPENAI_MODEL="gpt-5-nano"

# The pg-boss job queue, which keeps its jobs in the DATABASE_URL above - no
# second piece of infrastructure. It creates and migrates its own `pgboss`
# schema on start; Prisma knows nothing about those tables.
#
# QUEUE_ENABLED=false switches the whole thing off: nothing is enqueued, no
# schema is created, and a new ticket is never classified or auto-resolved. That
# is how the e2e stack runs. Default true.
# QUEUE_ENABLED=true
#
# RUN_WORKERS=false makes this process enqueue but not consume, for running the
# API and `bun run worker` as separate deployments. One process doing both is
# the default and is what `bun run dev` gives you. Default true.
# RUN_WORKERS=true
#
# The schema pg-boss owns. Only worth changing if something else has claimed it.
# QUEUE_SCHEMA=pgboss

# End-to-end tests use a separate database and their own settings, loaded from
# .env.test (committed defaults) plus .env.test.local (gitignored, holds the
# real DATABASE_URL for helpdesk_test) when NODE_ENV=test. See CLAUDE.md.
