{
  "name": "helpdesk",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server", "e2e"],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:client": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "test:unit": "bun run --cwd client test",
    "test:e2e": "bun run --cwd e2e test"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
